	<file source-language="en" target-language="de" datatype="plaintext" original="messages" date="2026-04-17T12:43:45Z"
		  product-name="xima_typo3_calendar">
		<body>
			<trans-unit id="indexer.event.title" approved="yes">
				<source>Calendar events (xima_typo3_calendar)</source>
				<target>Kalender-Veranstaltungen (xima_typo3_calendar)</target>
			</trans-unit>
			<trans-unit id="indexer.event.indexPastEvents" approved="yes">
				<source>Index past events</source>
				<target>Vergangene Veranstaltungen indizieren</target>
			</trans-unit>
			<trans-unit id="indexer.event.indexPastEvents.description" approved="yes">
				<source>Also index events whose appointments have all ended. Without this option an event leaves the index once its last appointment is over.</source>
				<target>Auch Veranstaltungen indizieren, deren Termine alle vorbei sind. Ohne diese Option verlässt eine Veranstaltung den Index, sobald ihr letzter Termin vorüber ist.</target>
			</trans-unit>
			<trans-unit id="extConf.unrestrictedRecordTypes">
				<source />
				<target>Datensatztypen, die von den Frontend-Abfrageeinschränkungen ausgeschlossen sind (durch Kommas getrennte record_type-Werte, z. B. "private-event"). Veranstaltungen und Einträge dieser Datensatztypen umgehen die Status-/Besitzer-Sichtbarkeitseinschränkungen.</target>
			</trans-unit>
			<trans-unit id="extConf.notifications.parentCategory">
				<source />
				<target>Übergeordnete Kategorie für die Benachrichtigungsfilterung</target>
			</trans-unit>
			<trans-unit id="extConf.features.requirementsManagement">
				<source />
				<target>Anforderungsmanagement:Ermöglicht die Verwaltung von Anforderungen für die Veranstaltungstermine</target>
			</trans-unit>
			<trans-unit id="next_appointment_start_date">
				<source />
				<target>Nächster Termin</target>
			</trans-unit>
			<trans-unit id="plugin.event_list.title">
				<source>Event list</source>
				<target>Veranstaltungsliste</target>
			</trans-unit>
			<trans-unit id="plugin.event_list.description">
				<source>List of events</source>
				<target>Liste mit Veranstaltungen</target>
			</trans-unit>
			<trans-unit id="plugin.event_detail.title">
				<source>Event detail</source>
				<target>Veranstaltungsdetails</target>
			</trans-unit>
			<trans-unit id="plugin.event_detail.description">
				<source>Detail view of events</source>
				<target>Detailansicht einer Veranstaltung</target>
			</trans-unit>
			<trans-unit id="notifications.tab">
				<source>Notifications</source>
				<target>Benachrichtigungen</target>
			</trans-unit>
			<trans-unit id="notifications.notify_review">
				<source>Notify me when new events are submitted for review</source>
				<target>Benachrichtigen, wenn neue Veranstaltungen zur Prüfung eingereicht werden</target>
			</trans-unit>
			<trans-unit id="notifications.notify_live">
				<source>Notify me when live events are edited</source>
				<target>Benachrichtigen, wenn Live-Veranstaltungen bearbeitet werden</target>
			</trans-unit>
			<trans-unit id="notifications.notify_categories">
				<source>Only notify for events in these categories (leave empty for all)</source>
				<target>Nur für Veranstaltungen in diesen Kategorien benachrichtigen (leer = alle)</target>
			</trans-unit>
			<trans-unit id="notifications.notify_categories.empty">
				<source>No categories available.</source>
				<target>Keine Kategorien verfügbar.</target>
			</trans-unit>
			<trans-unit id="permissions.header">
				<source>Calendar</source>
				<target>Kalender</target>
			</trans-unit>
			<trans-unit id="permissions.publish_live_events.label">
				<source>Publish events (set live)</source>
				<target>Veranstaltungen veröffentlichen (live setzen)</target>
			</trans-unit>
			<trans-unit id="permissions.publish_live_events.description">
				<source>Allows setting events to the live status and thereby publishing them.</source>
				<target>Erlaubt das Setzen von Veranstaltungen auf den Live-Status und damit deren Veröffentlichung.</target>
			</trans-unit>
			<trans-unit id="permissions.view_all_events.label">
				<source>See all events</source>
				<target>Alle Veranstaltungen sehen</target>
			</trans-unit>
			<trans-unit id="permissions.view_all_events.description">
				<source>Allows seeing all draft, review and rejected events, not only the own ones.</source>
				<target>Erlaubt das Sehen aller Entwürfe, Prüfungen und abgelehnten Veranstaltungen, nicht nur der eigenen.</target>
			</trans-unit>
			<trans-unit id="calendar.button.today">
				<source>today</source>
				<target>Heute</target>
			</trans-unit>
			<trans-unit id="calendar.button.dayGridMonth">
				<source>month</source>
				<target>Monat</target>
			</trans-unit>
			<trans-unit id="calendar.button.timeGridWeek">
				<source>week</source>
				<target>Woche</target>
