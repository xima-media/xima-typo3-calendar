				<source>Previous month</source>
				<target>Voriger Monat</target>
			</trans-unit>
			<trans-unit id="calendar.button.next.month">
				<source>Next month</source>
				<target>Nächster Monat</target>
			</trans-unit>
			<trans-unit id="calendar.button.prev.week">
				<source>Previous week</source>
				<target>Vorige Woche</target>
			</trans-unit>
			<trans-unit id="calendar.button.next.week">
				<source>Next week</source>
				<target>Nächste Woche</target>
			</trans-unit>
		</body>
